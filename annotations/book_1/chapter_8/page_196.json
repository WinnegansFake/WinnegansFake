    },
    {
      "line_number": 2,
      "target_phrase": "Anna Livia! I want to hear",
      "annotation_text": "Anna Livia Plurabelle represents the River Liffey and the eternal feminine archetype. This chapter was the first excerpt recorded by Joyce on phonograph in 1929.",
      "categories": [
        "character-alp",
        "media-recording",
        "history"
      ],
      "cross_references": [
        "003.15",
        "628.01"
      ],
      "sources": [
        "https://www.fweet.org/cgi-bin/fw_grep.cgi?srch=anna+livia",
        "https://finwake.com/1024chapter8/1024chap8.htm",
        "https://scribd.com/doc/anna-livia-study"
      ],
      "contributors": [
        "joycean-scholar",
        "open-wake-editor"
      ],
      "id": "196.02-95f6"
    },
    {
      "line_number": 3,
      "target_phrase": "Well, you know Anna Livia?",
      "annotation_text": "The response establishes the dialogic form of the chapter, where history is recounted through the mundane activity of washing clothes, transforming into myth.",
      "categories": [
        "mythology",
        "character-dialogue"
      ],
      "cross_references": [
        "196.01"
      ],
      "sources": [
        "https://editura.mttlc.ro/joyce-lexicons.html",
