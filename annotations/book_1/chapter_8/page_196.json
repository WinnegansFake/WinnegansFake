      ],
      "contributors": [
        "joycean-scholar",
        "open-wake-editor"
      ],
      "id": "196.03-c215"
    },
    {
      "line_number": 4,
      "target_phrase": "Yes, of course",
      "annotation_text": "The familiar tone masks the vast geographical and historical scope of the chapter, which contains over a thousand hidden river names worldwide.",
      "categories": [
        "river-motif",
        "geography"
      ],
      "cross_references": [
