    {
      "line_number": 6,
      "target_phrase": "Tell me all.",
      "annotation_text": "The repeated demand for knowledge parallels the reader's quest to understand the Wake itself, driven by curiosity about the archetypal parents.",
      "categories": [
        "reader-address",
        "motif-quest"
      ],
      "cross_references": [
        "196.01"
      ],
