        "open-wake-editor"
      ]
    },
    {
      "line_number": 5,
      "target_phrase": "we all know Anna Livia.",
      "annotation_text": "Universalizes ALP, connecting her to all rivers and all mothers, reflecting the 'plurabelle' (many-beautiful) nature of her character.",
      "categories": [
        "character-alp",
        "universalism"
