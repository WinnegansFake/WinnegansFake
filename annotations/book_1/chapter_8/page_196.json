      "id": "196.06-3683"
    },
    {
      "line_number": 7,
      "target_phrase": "Tell me now.",
      "annotation_text": "The urgency of the washerwomen's gossip reflects the flowing passage of time and the flowing of the river before it meets the sea.",
      "categories": [
        "time-theme",
        "river-motif"
      ],
      "cross_references": [
