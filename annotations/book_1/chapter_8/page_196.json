    {
      "id": "196.05-7439",
      "line_number": 5,
      "target_phrase": "scrubbing the muddy banks",
      "annotation_text": "The physical labor of the washerwomen. They clean the dirty linen of HCE, metaphorically airing his dirty laundry and washing away his sins in the Liffey.",
      "categories": [
        "washing",
        "liffey",
        "sin"
      ],
