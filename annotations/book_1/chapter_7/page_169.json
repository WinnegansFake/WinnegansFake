      ],
      "contributors": [
        "joycean-scholar",
        "open-wake-editor"
      ]
    },
    {
      "id": "169.05-9d39",
      "line_number": 5,
      "target_phrase": "lowly fraud",
      "annotation_text": "The devastating self-portrait begins. Joyce strips away romantic notions of the artist, presenting Shem as a trickster and a plagiarist rather than a genius.",
      "categories": [
        "shem",
        "meta-fiction"
      ],
      "cross_references": [
        "169.01"
      ],
      "sources": [
        "John Gordon's Finnegans Blog. http://johngordonfinnegan.weebly.com/"
      ],
      "contributors": [
        "joycean-scholar",
        "open-wake-editor"
      ]
    },
    {
      "id": "169.11-b41b",
      "line_number": 11,
      "target_phrase": "forger of the word",
      "annotation_text": "A pun on Daedalus 'forging' the uncreated conscience of his race, now degraded to literal criminal forgery. Shem creates art by stealing and twisting existing texts.",
      "categories": [
        "forgery",
        "art"
      ],
      "cross_references": [
        "169.01",
        "104.31"
      ],
      "sources": [
        "JJDA. http://www.jjda.ie/"
      ],
      "contributors": [
        "joycean-scholar",
        "open-wake-editor"
      ]
    },
    {
      "id": "169.15-89a8",
      "line_number": 15,
      "target_phrase": "writing on his own skin",
      "annotation_text": "The ultimate act of self-consumption and solipsism. Shem uses his own body as parchment, reflecting Joyce's deeply autobiographical and physically taxing writing process.",
      "categories": [
        "body",
        "writing"
      ],
      "cross_references": [
        "169.21"
      ],
      "sources": [
        "Genetic Joyce Studies. http://www.geneticjoycestudies.org/"
      ],
      "contributors": [
        "joycean-scholar",
        "open-wake-editor"
      ]
    },
    {
      "id": "169.21-b67a",
      "line_number": 21,
      "target_phrase": "inked with his excrement",
      "annotation_text": "A shocking grotesque image. It suggests that literature is produced from the base waste of the author's life, echoing the hen's discovery in the midden heap.",
      "categories": [
        "filth",
        "art",
        "body"
      ],
      "cross_references": [
        "104.10",
        "169.15"
      ],
      "sources": [
        "Mark Troy's Mummeries of Resurrection. http://rosenlake.net/"
      ],
      "contributors": [
