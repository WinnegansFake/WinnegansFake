    },
    {
      "id": "169.30-c325",
      "line_number": 30,
      "target_phrase": "exile's corner",
      "annotation_text": "The physical and spiritual isolation of the artist. Shem is cast out from normal society, a clear parallel to Joyce's self-imposed exile in Europe.",
      "categories": [
        "exile",
        "joyce"
      ],
