        "open-wake-editor"
      ]
    },
    {
      "id": "169.26-e150",
      "line_number": 26,
      "target_phrase": "blasphemer",
      "annotation_text": "Shem's defiance of orthodox religion. His writing is presented as an anti-sacrament, a dark parody of the Word made flesh.",
      "categories": [
        "religion",
        "shem"
      ],
      "cross_references": [
