    {
      "id": "023.05-5ef2",
      "line_number": 5,
      "target_phrase": "Perkodhuskurunbarggruauyagokgorlayorgromgremghornabhorn...",
      "annotation_text": "The second thunderclap (100 letters) representing the fall of the Tower of Babel. It encodes words for thunder in Latin, Gaelic, Norse, and French, embodying the confusion of tongues and the scattering of peoples across the globe.",
      "categories": [
        "thunderword",
