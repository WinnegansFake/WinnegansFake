    {
      "id": "023.09-71e7",
      "line_number": 9,
      "target_phrase": "tongues of confusion",
      "annotation_text": "Explicitly names the punishment of Babel, reinforcing the theme of the preceding thunderword. This is the moment where unified human language shatters into plurabilities.",
      "categories": [
        "babel",
        "religion"
      ],
      "cross_references": [
