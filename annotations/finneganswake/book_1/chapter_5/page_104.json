      "id": "104.04-8fad",
      "line_number": 4,
      "target_phrase": "Biddy Doran",
      "annotation_text": "The hen who scratches up the mysterious document from the midden heap. She embodies the lowly, persistent historian recovering the past from literal garbage.",
      "categories": [
        "hen",
        "history"
      ],
      "cross_references": [
        "104.10"
      ],
      "sources": [
        "John Gordon's Finnegans Blog. http://johngordonfinnegan.weebly.com/"
      ],
      "contributors": [
        "joycean-scholar",
        "open-wake-editor"
      ]
    },
    {
      "id": "104.10-1b4d",
      "line_number": 10,
      "target_phrase": "the midden dump",
      "annotation_text": "The site of discovery. Joyce equates the excavation of the letter to an archaeological dig, suggesting that history is found in the discarded refuse of daily life.",
      "categories": [
        "archaeology",
        "letter"
      ],
      "cross_references": [
        "104.04"
      ],
      "sources": [
        "Mark Troy's Mummeries of Resurrection. http://rosenlake.net/"
      ],
      "contributors": [
        "joycean-scholar",
        "open-wake-editor"
      ]
    },
    {
      "id": "104.14-e38f",
      "line_number": 14,
      "target_phrase": "scratched up a scrap",
      "annotation_text": "The physical act of finding the text. The hen's scratching mimics the monk's pen scratching on vellum, a central metaphor of this chapter.",
      "categories": [
        "hen",
        "writing"
      ],
      "cross_references": [
