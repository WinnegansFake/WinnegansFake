    {
      "id": "104.22-a604",
      "line_number": 22,
      "target_phrase": "illuminated with mud",
      "annotation_text": "A paradox that defines Shem's aesthetic. The sacred text is decorated not with gold, but with the literal filth of the earth, merging the high and the low.",
      "categories": [
        "art",
        "filth"
      ],
