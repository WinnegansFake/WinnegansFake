    {
      "id": "104.18-54b7",
      "line_number": 18,
      "target_phrase": "Tunc page",
      "annotation_text": "A direct reference to the Book of Kells (Matthew 27:38). Joyce elevates the hen's soiled scrap to the status of Ireland's greatest illuminated manuscript.",
      "categories": [
        "book-of-kells",
        "manuscript"
      ],
      "cross_references": [
