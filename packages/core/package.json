{
  "name": "@winnegans/core",
  "version": "0.1.0",
  "description": "Universal coordinate system, data models, analytical registers, and concordance index for book annotations",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "annotation",
    "literature",
    "concordance",
    "coordinates",
    "digital-humanities"
  ],
  "license": "CC-BY-SA-4.0",
  "devDependencies": {
    "@types/node": "^20",
    "tsup": "^8.4.0",
    "typescript": "^5"
  }
}
